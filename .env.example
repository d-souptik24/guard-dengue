# ==============================================================================
# GuardDengue — Root Environment Configuration Example (.env.example)
# Copy this file to .env and populate with your credentials.
# DO NOT commit real secrets or passwords to version control.
# ==============================================================================

# --- Google Gemini / Vertex AI Configuration ---
# Required for LLM/SLM inference, claim verification, and semantic passes
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- Neo4j AuraDB Cloud / Local Graph Configuration ---
# Live AuraDB instance or local bolt connection (e.g. bolt://localhost:7687)
NEO4J_URI=neo4j+ssc://<your-aura-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_aura_instance_id_here
AURA_INSTANCENAME="GuardDengue Instance"

# --- Runtime Configuration ---
# Corpus release tag synchronized with Module 2 knowledge ingestion pipeline
CORPUS_RELEASE=v0.1-dev

# SLM Provider: "mock" (offline testing) | "local" (GGUF/vLLM) | "api" (cloud LLM)
SLM_PROVIDER=mock
SLM_MODEL_NAME=Ministral-3B-Medical-v1
DEBUG=false
