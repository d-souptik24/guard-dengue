      "dot": "rose",
      "title": "Dual Safety Guardrails",
      "items": [
        "Pre-retrieval emergency screening routes red flags to immediate hospital escalation templates",
        "Post-generation claim verification compares claims against canonical chunks before release",
        "Deterministic abstention when evidence is contradictory or insufficient"
      ]
    },
    {
      "dot": "cyan",
      "title": "Evidence Grounding",
      "items": [
        "Offline preparation with Docling preserves clinical table structures and flowchart logic",
        "Hybrid dense + sparse BM25 retrieval with strict metadata release allowlists",
        "Neo4j clinical graph models explicit drug contraindications (e.g., NSAID/aspirin avoidance)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stateful Orchestration",
      "items": [
        "LangGraph manages strict state transitions and bounded one-shot revision loops",
        "Decoupled from model memory: outputs cite canonical evidence passages",
        "Separates health education awareness from diagnostic and prescribing boundaries"
