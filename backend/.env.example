# ==============================================================================
# GuardDengue — Backend Environment Configuration Example (.env.example)
# Copy this file to .env inside ./backend and populate with your credentials.
# DO NOT commit real secrets or passwords to version control.
# ==============================================================================

# --- Application Identity & Serving ---
APP_NAME="GuardDengue Backend"
APP_VERSION="2.0 (Plan v2)"
DEBUG=false
CORPUS_RELEASE=v0.1-dev

# --- Model Serving Settings ---
# Provider options: "mock" (offline testing) | "local" (GGUF/vLLM) | "api" (cloud LLM)
SLM_PROVIDER=mock
SLM_MODEL_NAME=Ministral-3B-Medical-v1

# --- Google Gemini API Configuration ---
# Required when SLM_PROVIDER=api or when running benchmark evaluations
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- Neo4j AuraDB Cloud / Local Graph Configuration ---
# Used for deterministic medication contraindications and clinical relationship queries
NEO4J_URI=neo4j+ssc://<your-aura-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_aura_instance_id_here
AURA_INSTANCENAME="GuardDengue Instance"

# --- Optional Custom Storage Paths (defaults resolve automatically) ---
# SQLITE_DB_PATH=backend/knowledge_pipeline/extracted/guarddengue_chunks.db
# QDRANT_STORAGE_DIR=backend/knowledge_pipeline/extracted/qdrant_local
# POLICY_FILE_PATH=backend/knowledge_pipeline/extracted/safety_policy_v0.1-dev.json
